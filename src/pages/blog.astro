---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";

const posts = Object.values(import.meta.glob("./posts/*.md", { eager: true }));
const pageTitle = "LeBlog";
---

<BaseLayout pageTitle={pageTitle}>
    <h1>{pageTitle}</h1>
    <p>
        Hello there! Welcome to LeBlog, the best blog on the internet for people
        who enjoy blogs written by me.
    </p>
    <p>
        Even if this is not the best blog on the internet for you, I hope you
        find some value in this.
    </p>
    <p>Happy reading!</p>
    <h2>Posts</h2>
    <ul>
        {
            posts.map((post: any) => (
                <BlogPost url={post.url} title={post.frontmatter.title} />
            ))
        }
    </ul>
</BaseLayout>
