---
import BaseLayout from "../layouts/BaseLayout.astro";

const identity = {
    firstName: "Logan",
    country: "US",
    occupation: "Student",
    hobbies: ["nix", "tech", "touching grass"],
};

const skills = ["Nix", "JavaScript", "React", "C++", "Astro"];
---

<BaseLayout pageTitle="About">
    <h1>About</h1>
    <p>I use Nix btw</p>
    <p>My name is {identity.firstName}</p>
    <li>
        I live in {identity.country} and I work as a {identity.occupation}.
    </li>
    {
        identity.hobbies.length >= 2 && (
            <li>
                Two of my hobbies are: {identity.hobbies[0]} and{" "}
                {identity.hobbies[1]}
            </li>
        )
    }
    <p>My skills are:</p>
    <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
</BaseLayout>
